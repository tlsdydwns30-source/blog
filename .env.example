# ── 초안 생성 (/api/draft) ─────────────────────────────
# provider 전환: "anthropic"(기본) | "openai"
LLM_PROVIDER=anthropic
# 모델 ID (미지정 시 provider별 기본값). 예: claude-sonnet-5 / gpt-4o-mini
DRAFT_MODEL=

# Anthropic 사용 시 (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI 호환 무료 티어 사용 시 (LLM_PROVIDER=openai)
#  - Google AI Studio(Gemini), Groq 등 OpenAI 호환 엔드포인트로 교체 가능
OPENAI_API_KEY=
OPENAI_BASE_URL=            # 예: https://api.groq.com/openai/v1 (비우면 OpenAI 기본)

# ── Supabase (사진 매칭 / 상위글 분석 / 가격 스냅샷) ───────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=       # service_role 키 — 서버 전용, 절대 클라이언트 노출 금지

# ── 사진 매칭 (임베딩·비전) — Groq와 별개 키 필요 ──────────
# 임베딩 (텍스트→벡터, 1536차원 = text-embedding-3-small)
EMBED_API_KEY=
EMBED_BASE_URL=            # 기본 https://api.openai.com/v1
EMBED_MODEL=              # 기본 text-embedding-3-small
# 비전 (사진→캡션). Gemini OpenAI호환/OpenAI 등
VISION_API_KEY=
VISION_BASE_URL=          # 기본 https://api.openai.com/v1
VISION_MODEL=             # 기본 gpt-4o-mini
# 색인 스크립트용 사진 폴더
PHOTOS_DIR=
# (선택) 프론트에서 추천 사진 썸네일을 띄울 공개 URL 베이스.
#  storage_path 앞에 붙여 이미지 주소를 만듦. 예) Supabase Storage 공개 버킷 URL
#  미설정 시 썸네일 대신 파일경로 텍스트만 표시(매칭 자체는 동작).
NEXT_PUBLIC_PHOTO_BASE_URL=

# ── 네이버 검색광고 API (키워드 추천) ────────────────────
# searchad.naver.com → 도구 → SA API 사용 관리 에서 발급 (무료)
NAVER_AD_API_KEY=          # 액세스라이선스
NAVER_AD_SECRET_KEY=       # 비밀키 (발급 시 1회만 표시)
NAVER_AD_CUSTOMER_ID=      # 고객 ID
